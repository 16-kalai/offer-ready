{
  "name": "werdict",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "drizzle-kit migrate && next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "tsx scripts/local-db.mts",
    "db:generate": "tsx --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed-roles": "tsx --env-file=.env.local scripts/seed-dev-roles.mts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "worker:start": "tsx --import ./scripts/server-only-shim.mjs scripts/worker.mts",
    "worker": "tsx watch --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/worker.mts",
    "test:resumes": "tsx scripts/make-test-resumes.mts",
    "demo:resumes": "tsx scripts/make-demo-resumes.mts",
    "eval:matching": "tsx --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/eval-matching.mts",
    "rescore": "tsx --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/rescore.mts",
    "plans:regenerate": "tsx --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/regenerate-plans.mts",
    "eval:canary": "tsx --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/eval-canary.mts",
    "reports:write": "tsx --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/write-reports.mts",
    "eval:scoring": "tsx --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/eval-scoring.mts",
    "dev:mock-results": "tsx --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/mock-results.mts",
    "dev:demo-report": "tsx --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/demo-report.mts",
    "eval:cases": "tsx --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/eval-cases.mts",
    "live:smoke": "tsx --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/live-smoke.mts",
    "coach:run": "tsx --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/coach-run.mts",
    "demo:record": "tsx --import ./scripts/server-only-shim.mjs --env-file=.env.local scripts/demo/record.mts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@huggingface/transformers": "^4.3.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@vercel/blob": "^2.8.2",
    "better-auth": "1.7.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "pg-boss": "^12.38.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.x"
  }
}
