DATABASE_URL=postgres://postgres:postgres@localhost:54340/offerready
# 32+ random characters: node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# Gemini (AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Background jobs run inside the web app on Vercel (default there). Locally, run `pnpm worker`.
# JOBS_INLINE=false

# Hosted video uploads (Vercel Blob). Without it, videos go through the app to STORAGE_DRIVER.
# BLOB_READ_WRITE_TOKEN=

# Uploaded files: "disk" (STORAGE_DIR) or "database". Production defaults to "database".
# STORAGE_DRIVER=disk
